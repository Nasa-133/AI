{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/tools/run_metric_query.result.v1.json",
  "title": "run_metric_query natijasi (data)",
  "description": "Qiymatlar matn: Decimal string yoki o‘lcham qiymati; null — ma’lumot yo‘q yoki aniqlanmagan (masalan, maxraj 0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_spec_id",
    "dataset_snapshot_ids",
    "metric_versions",
    "period",
    "currency",
    "columns",
    "rows",
    "row_count",
    "truncated",
    "as_of",
    "notes"
  ],
  "properties": {
    "query_spec_id": {
      "type": "string",
      "format": "uuid"
    },
    "dataset_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "metric_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "version"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "integer"
          }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Korxona vaqt mintaqasidagi kunlar, ikkala chegara ham kiradi."
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "metric_id",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "dimension",
              "metric"
            ]
          },
          "metric_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "enum": [
                  "money",
                  "percent",
                  "count",
                  "quantity"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "maxItems": 5000
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
