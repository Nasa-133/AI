{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/tools/create_document_draft.args.v1.json",
  "title": "create_document_draft argumentlari",
  "description": "Base versiyadan yangi draft (TZ 9.4). expected_version_id — base versiya hali joriy ekanini tasdiqlash (parallel tahrir → xato).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "base_version_id",
    "expected_version_id",
    "operations",
    "comment"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "section_id",
          "find",
          "replace",
          "occurrence"
        ],
        "properties": {
          "op": {
            "enum": [
              "replace_text"
            ]
          },
          "section_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "find": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "replace": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      },
      "minItems": 1,
      "maxItems": 50
    },
    "comment": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
