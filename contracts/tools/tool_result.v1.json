{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/tools/tool_result.v1.json",
  "title": "Tool natijasi v1",
  "description": "Barcha vositalar uchun umumiy natija (TZ 12). Biznes xatosi HTTP 200 + status=error; autentifikatsiya/capability xatosi HTTP 401/403.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "data",
    "source_refs",
    "warnings",
    "error_code",
    "error_message",
    "trace_id"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "version_id",
          "locator"
        ],
        "properties": {
          "kind": {
            "enum": [
              "dataset_snapshot",
              "document_version",
              "query_result"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
