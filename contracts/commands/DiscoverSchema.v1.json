{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/commands/DiscoverSchema.v1.json",
  "title": "DiscoverSchema v1 (payload)",
  "description": "Business → Integration. Manba tuzilmasini o‘qish va canonical mapping taklifini olish.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_id",
    "data_source_id",
    "connector_id",
    "object_ref",
    "requested_by"
  ],
  "properties": {
    "discovery_id": {
      "type": "string",
      "format": "uuid"
    },
    "data_source_id": {
      "type": "string",
      "format": "uuid"
    },
    "connector_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "object_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bucket",
            "key",
            "checksum_sha256",
            "size_bytes"
          ],
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "checksum_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_by": {
      "type": "string",
      "format": "uuid"
    }
  }
}
