{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/canonical/inventory/movement.v1.json",
  "title": "inventory.movement v1",
  "description": "Ombor harakati. quantity_delta: kirim musbat, chiqim manfiy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "occurred_at",
    "warehouse_code",
    "branch_code",
    "product_code",
    "quantity_delta",
    "movement_type",
    "unit_cost",
    "currency"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "warehouse_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "branch_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "product_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quantity_delta": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "movement_type": {
      "enum": [
        "receipt",
        "sale",
        "return",
        "transfer_in",
        "transfer_out",
        "adjustment"
      ]
    },
    "unit_cost": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Decimal string"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
