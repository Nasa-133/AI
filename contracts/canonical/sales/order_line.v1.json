{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/canonical/sales/order_line.v1.json",
  "title": "sales.order_line v1",
  "description": "Bitta savdo hujjati satri. Summalar Decimal string; chegirma manbada ayrilgan bo‘lsa discount_already_deducted=true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_revision",
    "document_number",
    "occurred_at",
    "branch_code",
    "branch_name",
    "product_code",
    "product_name",
    "customer_code",
    "customer_name",
    "quantity",
    "unit_price",
    "gross_amount",
    "discount_amount",
    "discount_already_deducted",
    "vat_amount",
    "amount_includes_vat",
    "currency",
    "status",
    "cost_amount"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "document_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "branch_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "branch_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "product_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "product_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "customer_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "customer_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "unit_price": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "gross_amount": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "discount_amount": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "discount_already_deducted": {
      "type": "boolean"
    },
    "vat_amount": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string"
    },
    "amount_includes_vat": {
      "type": "boolean"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217"
    },
    "status": {
      "enum": [
        "confirmed",
        "draft",
        "cancelled"
      ]
    },
    "cost_amount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Decimal string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
