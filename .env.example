# Lokal ishlab chiqish uchun namunaviy sozlamalar. `cp .env.example .env` qiling.
# Haqiqiy secret’larni bu faylga yozmang.

# --- Platforma (docker compose) ---
POSTGRES_PASSWORD=postgres_dev
BUSINESS_DB_OWNER_PASSWORD=business_owner_dev
BUSINESS_DB_APP_PASSWORD=business_app_dev
AI_DB_OWNER_PASSWORD=ai_owner_dev
AI_DB_APP_PASSWORD=ai_app_dev
INTEGRATION_DB_OWNER_PASSWORD=integration_owner_dev
INTEGRATION_DB_APP_PASSWORD=integration_app_dev
RABBITMQ_DEFAULT_USER=abo
RABBITMQ_DEFAULT_PASS=abo_dev
# S3-mos ombor (lokal SeaweedFS, infra/compose/seaweedfs/s3.json)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=abo
S3_SECRET_KEY=abo_dev_password

# --- Business Core ---
# App role: RLS’ga bo‘ysunadi, jadval egasi emas.
BUSINESS_DATABASE_URL=postgresql+asyncpg://business_app:business_app_dev@localhost:55432/business
# Faqat migratsiya uchun (schema egasi).
BUSINESS_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://business_owner:business_owner_dev@localhost:55432/business
# Fernet kaliti: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUSINESS_DATA_ENCRYPTION_KEY=
BUSINESS_COOKIE_SECURE=false
# AI Runtime → Tool API. Ikkalasi ham kamida 32 belgi: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BUSINESS_TOOLS_SERVICE_TOKEN=
BUSINESS_CAPABILITY_SIGNING_KEY=
BUSINESS_AMQP_URL=amqp://abo:abo_dev@localhost:5672/
BUSINESS_REDIS_URL=redis://localhost:56379/0
BUSINESS_S3_ACCESS_KEY=abo
BUSINESS_S3_SECRET_KEY=abo_dev_password
BUSINESS_NOTIFIER=log
BUSINESS_SESSION_TTL_HOURS=12

# --- AI Runtime ---
AI_DATABASE_URL=postgresql+asyncpg://ai_app:ai_app_dev@localhost:55432/ai_runtime
AI_BUSINESS_TOOLS_URL=http://localhost:8000
# BUSINESS_TOOLS_SERVICE_TOKEN bilan bir xil qiymat
AI_BUSINESS_TOOLS_TOKEN=
AI_MODEL_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=
OPENAI_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=

# --- Integration Runtime ---
INTEGRATION_DATABASE_URL=postgresql+asyncpg://integration_app:integration_app_dev@localhost:55432/integration_runtime
INTEGRATION_AMQP_URL=amqp://abo:abo_dev@localhost:5672/
INTEGRATION_S3_ACCESS_KEY=abo
INTEGRATION_S3_SECRET_KEY=abo_dev_password
