{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/tools/create_dashboard.args.v1.json",
  "title": "create_dashboard argumentlari",
  "description": "Widget faqat mavjud query_spec_id’ga bog‘lanadi — raqamlar qayta o‘ylab topilmaydi (TZ 8.2). text turida query_spec_id null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "widgets"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "type",
          "query_spec_id",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "kpi",
              "line",
              "bar",
              "table",
              "text"
            ]
          },
          "query_spec_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 12
    }
  }
}
