{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-business-office/tools/compare_periods.args.v1.json",
  "title": "compare_periods argumentlari",
  "description": "Oldingi query’ni boshqa davr bilan solishtirish.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_spec_id",
    "comparison_range"
  ],
  "properties": {
    "query_spec_id": {
      "type": "string",
      "format": "uuid"
    },
    "comparison_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Korxona vaqt mintaqasidagi kunlar, ikkala chegara ham kiradi."
    }
  }
}
